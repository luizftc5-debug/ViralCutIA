# ViralCut AI configuration. Copy to `.env` (never commit the copy).
# Every VIRALCUT_* value is optional; the defaults are shown.

# ---- Web -------------------------------------------------------------------
# Address of the API as seen from the user's browser (compiled into the web bundle).
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- API -------------------------------------------------------------------
# Browser origins allowed to call the API (comma separated).
VIRALCUT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Run the worker inside the API process (handy for single-process local development).
VIRALCUT_EMBEDDED_WORKER=false

# ---- Storage and retention ---------------------------------------------------
VIRALCUT_DATA_DIR=./data
# Empty = SQLite file inside the data dir. Docker Compose sets PostgreSQL automatically.
# VIRALCUT_DATABASE_URL=postgresql+psycopg://user:password@host:5432/viralcut
POSTGRES_PASSWORD=viralcut
# Uploads, clips and their database rows are deleted this many hours after upload.
VIRALCUT_RETENTION_HOURS=24

# ---- Upload limits -----------------------------------------------------------
VIRALCUT_MAX_UPLOAD_MB=2048
VIRALCUT_MAX_DURATION_S=10800
VIRALCUT_UPLOADS_PER_HOUR_PER_IP=30

# ---- Speech recognition ------------------------------------------------------
# auto: large-v3 on a GPU, large-v3-turbo on a CPU with 4+ cores, small otherwise.
# fast | balanced | accurate force a mode (docs/TRANSCRIPTION.md has the measured trade-off).
VIRALCUT_TRANSCRIPTION_MODE=auto
# An explicit model always wins over the mode: tiny | base | small | medium | large-v3 | large-v3-turbo
# VIRALCUT_WHISPER_MODEL=
VIRALCUT_WHISPER_DEVICE=auto
# CTC forced alignment of word timestamps (Portuguese and English; Apache-2.0 models, downloaded once).
# off keeps Whisper's own timestamps, tightened against the loudness envelope.
VIRALCUT_ALIGN_MODE=auto
# Names and jargon the recogniser should prefer, comma separated (users can add more per job).
# VIRALCUT_GLOSSARY=
# Audio treatment for the recogniser only: auto (gain for very quiet audio) | on (adds denoising) | off
VIRALCUT_ASR_ENHANCE=auto
# VIRALCUT_MODELS_DIR=./models-cache

# ---- Optional LLM narrative analysis ---------------------------------------
# Without a key the engine uses heuristics and extractive titles, and labels results as such.
ANTHROPIC_API_KEY=
VIRALCUT_LLM_MODEL=claude-opus-5-5
VIRALCUT_LLM_EFFORT=medium

# ---- Selection ---------------------------------------------------------------
# Clips scoring below this are not rendered (users can override per job).
VIRALCUT_MIN_SCORE=60
# Score weights as JSON (renormalised). Example: {"hook":0.3,"narrative":0.2,"value":0.2,"impact":0.1,"self_contained":0.1,"technical":0.1}
# VIRALCUT_SCORE_WEIGHTS=

# ---- Resources (docs/PERFORMANCE.md) ----------------------------------------
# auto = recommended for the machine that runs the worker | eco | balanced | turbo
VIRALCUT_PERFORMANCE_PROFILE=auto
# Explicit overrides of the profile (0 / empty = let the profile decide)
# VIRALCUT_FFMPEG_THREADS=0
# VIRALCUT_RENDER_WORKERS=0
# Content-addressed cache of transcripts and analysis (expires with VIRALCUT_RETENTION_HOURS)
VIRALCUT_CACHE_MAX_MB=512

# ---- Rendering ---------------------------------------------------------------
VIRALCUT_X264_CRF=18
# empty = chosen by the profile (medium: measured best size/quality per CPU second)
VIRALCUT_X264_PRESET=
VIRALCUT_AUDIO_BITRATE=192k
VIRALCUT_NORMALIZE_AUDIO=true
VIRALCUT_MAX_FPS=60

# ---- Worker ------------------------------------------------------------------
VIRALCUT_MAX_ATTEMPTS=2
WORKER_CPUS=4
WORKER_MEMORY=6g
